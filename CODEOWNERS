# CODEOWNERS — mirrors ownership.yaml (S1 is the single source; keep in sync).
# CI additionally enforces per-session path ownership via ownership_guard.py.

# S1: contracts, schemas, docs, mocks, CI
/ownership.yaml              @session-1
/semlock/ir/                 @session-1
/semlock/extractors/base.py  @session-1
/semlock/extractors/registry.py @session-1
/schema/                     @session-1
/docs/                       @session-1
/mocks/                      @session-1
/.github/                    @session-1
/CODEOWNERS                  @session-1
/pyproject.toml              @session-1
/README.md                   @session-1

# S2: extraction + resolution (Python)
/semlock/extractors/python/     @session-2
/tests/unit/python/             @session-2
/tests/fixtures/python/         @session-2

# S3: extraction + resolution (TypeScript) — first-class per ADR-0008
/semlock/extractors/typescript/ @session-3
/semlock/resolution/            @session-3
/tests/unit/typescript/         @session-3
/tests/fixtures/typescript/     @session-3

# S4: graph + conflict engine (+ rule-format docs per ADR-0004)
/semlock/graph/             @session-4
/semlock/engine/            @session-4
# GitHub CODEOWNERS is LAST-match-wins: keep this specific rule AFTER /docs/.
/docs/format/               @session-4

# S5: git/cli/output/config/cache — git|cli|output are TEMPORARY co-ownership with
# S4 (see ownership.yaml arbitration note); expires at S5's first landing.
/semlock/git/               @session-4 @session-5
/semlock/cli/               @session-4 @session-5
/semlock/output/            @session-4 @session-5
/semlock/config/            @session-5
/semlock/cache/             @session-5

# S6: benchmarks + corpus
/bench/                     @session-6
/corpus/                    @session-6
